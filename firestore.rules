rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Super Admin helper for MarketMate Founder & Platform Admin Portal
    function isSuperAdmin() {
      return isSignedIn() &&
        request.auth.token.email != null &&
        request.auth.token.email.lower() in [
          'getmarketmate@gmail.com',
          'osovoyoronogheneovo@gmail.com'
        ];
    }

    function isOwnerOfBusiness(businessId) {
      return isSignedIn() && (
        isSuperAdmin() ||
        request.auth.uid == businessId ||
        (
          exists(/databases/$(database)/documents/businesses/$(businessId)) &&
          (
            get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid ||
            get(/databases/$(database)/documents/businesses/$(businessId)).data.userId == request.auth.uid
          )
        )
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Checks that non-admin merchants do not modify privileged subscription entitlement fields
    function doesNotModifySubscriptionFields() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'isSubscribed',
        'subscriptionStatus',
        'subscriptionPlan',
        'subscriptionPlanId',
        'subscribedAt',
        'subscriptionStartsAt',
        'subscriptionExpiresAt',
        'lastSubscriptionRequestId',
        'subscriptionUpdatedAt',
        'subscriptionUpdatedBy'
      ]);
    }

    // Checks that newly created business profiles by merchants do not self-grant paid subscriptions
    function hasSafeInitialSubscriptionState() {
      return (
        (!('isSubscribed' in incoming()) || incoming().isSubscribed == false) &&
        (!('subscriptionStatus' in incoming()) || incoming().subscriptionStatus == 'free') &&
        !('subscriptionExpiresAt' in incoming()) &&
        !('subscriptionStartsAt' in incoming())
      );
    }

    // ===============================================================
    // User Profiles (/users/{userId})
    // ===============================================================
    match /users/{userId} {
      allow get: if isOwner(userId) || isSuperAdmin();
      allow list: if isSuperAdmin();
      allow create: if isOwner(userId) && incoming().uid == request.auth.uid;
      allow update: if (isOwner(userId) && incoming().uid == existing().uid) || isSuperAdmin();
      allow delete: if isOwner(userId) || isSuperAdmin();
    }

    // ===============================================================
    // Platform Announcements & Broadcasts (/platform_announcements/{announcementId})
    // ===============================================================
    match /platform_announcements/{announcementId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() || isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // ===============================================================
    // Referral Code Mappings (/referral_codes/{code})
    // ===============================================================
    match /referral_codes/{code} {
      allow get: if isSignedIn();
      allow list: if isSuperAdmin();
      allow create, update: if isSignedIn() &&
        incoming().userId == request.auth.uid &&
        code == ('MM-' + request.auth.uid[0:6].upper());
      allow delete: if isSuperAdmin();
    }

    // ===============================================================
    // Permanent Referral Programme & Reward Ledger (/referrals/{referralId})
    // ===============================================================
    match /referrals/{referralId} {
      // Merchants can only read referrals where they are the referrer or the referred user.
      // Super Admins can read all referrals across the platform.
      allow get, list: if isSignedIn() && (
        isSuperAdmin() ||
        resource.data.referredUserId == request.auth.uid ||
        resource.data.referrerUserId == request.auth.uid ||
        resource.data.referrerCode == ('MM-' + request.auth.uid[0:6].upper())
      );

      // Authenticated newly registered users can only create their own pending referral record,
      // cannot refer themselves, and cannot self-grant subscription qualification.
      allow create: if isSignedIn() && (
        isSuperAdmin() ||
        (
          incoming().referredUserId == request.auth.uid &&
          incoming().referrerCode is string &&
          incoming().referrerCode != ('MM-' + request.auth.uid[0:6].upper()) &&
          (!('referrerUserId' in incoming()) || incoming().referrerUserId != request.auth.uid) &&
          incoming().referredSubscribed == false &&
          incoming().status == 'pending_subscription' &&
          incoming().discountPercent == 5 &&
          (!('subscribedAt' in incoming()) || incoming().subscribedAt == null)
        )
      );

      // Regular merchants cannot alter referral reward fields (status, referredSubscribed,
      // discountPercent, subscribedAt, referrerCode, referredUserId); they may only sync
      // their own referredBusinessName/referredUserEmail while still pending.
      // Super Admins can update referral qualification and subscription rewards.
      allow update: if isSignedIn() && (
        isSuperAdmin() ||
        (
          existing().referredUserId == request.auth.uid &&
          existing().status == 'pending_subscription' &&
          existing().referredSubscribed == false &&
          incoming().referredSubscribed == false &&
          incoming().status == 'pending_subscription' &&
          incoming().discountPercent == existing().discountPercent &&
          incoming().referrerCode == existing().referrerCode &&
          incoming().referredUserId == existing().referredUserId &&
          incoming().diff(existing()).affectedKeys().hasOnly(['referredBusinessName', 'referredUserEmail'])
        )
      );

      allow delete: if isSuperAdmin();
    }

    // ===============================================================
    // Platform Configuration (/platform_config/{configId})
    // ===============================================================
    match /platform_config/{configId} {
      allow get, list: if true;
      allow create, update, delete: if isSuperAdmin();
    }

    // ===============================================================
    // Subscription Bank Transfer Requests (/subscription_requests/{requestId})
    // ===============================================================
    match /subscription_requests/{requestId} {
      allow get, list: if isSignedIn() && (
        isSuperAdmin() ||
        resource.data.userId == request.auth.uid ||
        isOwnerOfBusiness(resource.data.businessId)
      );
      allow create: if isSignedIn() &&
        incoming().userId == request.auth.uid &&
        incoming().status == 'pending' &&
        !('reviewedBy' in incoming()) &&
        !('reviewedAt' in incoming()) &&
        !('grantedStartsAt' in incoming()) &&
        !('grantedExpiresAt' in incoming());
      allow update, delete: if isSuperAdmin();
    }

    // ===============================================================
    // Subscription Audit Trail (/subscription_audit_logs/{logId})
    // ===============================================================
    match /subscription_audit_logs/{logId} {
      allow get, list: if isSignedIn() && (
        isSuperAdmin() ||
        resource.data.actorId == request.auth.uid ||
        isOwnerOfBusiness(resource.data.businessId)
      );
      allow create: if isSignedIn() && (
        isSuperAdmin() ||
        (
          incoming().actorId == request.auth.uid &&
          incoming().action == 'subscription_request_submitted'
        )
      );
      allow update, delete: if isSuperAdmin();
    }

    // ===============================================================
    // User Support & Inquiries (/support_tickets/{ticketId})
    // ===============================================================
    match /support_tickets/{ticketId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (isSuperAdmin() || resource.data.userId == request.auth.uid);
      allow delete: if isSuperAdmin();
    }

    // ===============================================================
    // Businesses (/businesses/{businessId})
    // ===============================================================
    match /businesses/{businessId} {
      allow get: if isSignedIn() && (
        isOwnerOfBusiness(businessId) ||
        resource.data.ownerId == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        isSuperAdmin()
      );
      allow list: if isSignedIn() && (
        isSuperAdmin() ||
        resource.data.ownerId == request.auth.uid ||
        resource.data.userId == request.auth.uid
      );
      allow create: if isSignedIn() && (
        isSuperAdmin() ||
        (
          (incoming().ownerId == request.auth.uid || incoming().userId == request.auth.uid) &&
          hasSafeInitialSubscriptionState()
        )
      );
      allow update: if isSignedIn() && (
        isSuperAdmin() ||
        (
          (isOwnerOfBusiness(businessId) || existing().ownerId == request.auth.uid || existing().userId == request.auth.uid) &&
          doesNotModifySubscriptionFields()
        )
      );
      allow delete: if isOwnerOfBusiness(businessId) || isSuperAdmin();

      // ===============================================================
      // Products Subcollection (/businesses/{businessId}/products/{productId})
      // ===============================================================
      match /products/{productId} {
        allow get, list: if isOwnerOfBusiness(businessId);
        allow create: if isOwnerOfBusiness(businessId) && incoming().name is string && incoming().name.size() > 0;
        allow update: if isOwnerOfBusiness(businessId) && incoming().name is string && incoming().name.size() > 0;
        allow delete: if isOwnerOfBusiness(businessId);
      }

      // ===============================================================
      // Sales Subcollection (/businesses/{businessId}/sales/{saleId})
      // ===============================================================
      match /sales/{saleId} {
        allow get, list: if isOwnerOfBusiness(businessId);
        allow create: if isOwnerOfBusiness(businessId);
        allow update: if isOwnerOfBusiness(businessId);
        allow delete: if isOwnerOfBusiness(businessId);
      }

      // ===============================================================
      // Expenses Subcollection (/businesses/{businessId}/expenses/{expenseId})
      // ===============================================================
      match /expenses/{expenseId} {
        allow get, list: if isOwnerOfBusiness(businessId);
        allow create: if isOwnerOfBusiness(businessId);
        allow update: if isOwnerOfBusiness(businessId);
        allow delete: if isOwnerOfBusiness(businessId);
      }

      // ===============================================================
      // Invoices Subcollection (/businesses/{businessId}/invoices/{invoiceId})
      // ===============================================================
      match /invoices/{invoiceId} {
        allow get, list: if isOwnerOfBusiness(businessId);
        allow create: if isOwnerOfBusiness(businessId);
        allow update: if isOwnerOfBusiness(businessId);
        allow delete: if isOwnerOfBusiness(businessId);
      }

      // ===============================================================
      // Contacts Subcollection (/businesses/{businessId}/contacts/{contactId})
      // ===============================================================
      match /contacts/{contactId} {
        allow get, list: if isOwnerOfBusiness(businessId);
        allow create: if isOwnerOfBusiness(businessId) && incoming().name is string && incoming().name.size() > 0;
        allow update: if isOwnerOfBusiness(businessId) && incoming().name is string && incoming().name.size() > 0;
        allow delete: if isOwnerOfBusiness(businessId);
      }

      // ===============================================================
      // Debts Subcollection (/businesses/{businessId}/debts/{debtId})
      // ===============================================================
      match /debts/{debtId} {
        allow get, list: if isOwnerOfBusiness(businessId);
        allow create: if isOwnerOfBusiness(businessId);
        allow update: if isOwnerOfBusiness(businessId);
        allow delete: if isOwnerOfBusiness(businessId);
      }

      // ===============================================================
      // Goals Subcollection (/businesses/{businessId}/goals/{goalId})
      // ===============================================================
      match /goals/{goalId} {
        allow get, list: if isOwnerOfBusiness(businessId);
        allow create: if isOwnerOfBusiness(businessId);
        allow update: if isOwnerOfBusiness(businessId);
        allow delete: if isOwnerOfBusiness(businessId);
      }

      // ===============================================================
      // Backups Subcollection (/businesses/{businessId}/backups/{backupId})
      // ===============================================================
      match /backups/{backupId} {
        allow get, list: if isOwnerOfBusiness(businessId);
        allow create: if isOwnerOfBusiness(businessId);
        allow update: if isOwnerOfBusiness(businessId);
        allow delete: if isOwnerOfBusiness(businessId);
      }

      // ===============================================================
      // Staff Accounts Subcollection (/businesses/{businessId}/staff/{staffId})
      // ===============================================================
      match /staff/{staffId} {
        allow get, list: if isOwnerOfBusiness(businessId);
        allow create: if isOwnerOfBusiness(businessId);
        allow update: if isOwnerOfBusiness(businessId);
        allow delete: if isOwnerOfBusiness(businessId);
      }

      // ===============================================================
      // Staff Shift Logs Subcollection (/businesses/{businessId}/shifts/{shiftId})
      // ===============================================================
      match /shifts/{shiftId} {
        allow get, list: if isOwnerOfBusiness(businessId);
        allow create: if isOwnerOfBusiness(businessId);
        allow update: if isOwnerOfBusiness(businessId);
        allow delete: if isOwnerOfBusiness(businessId);
      }
    }
  }
}
